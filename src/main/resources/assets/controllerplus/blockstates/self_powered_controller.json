{
  "multipart": [
    {
      "when": {
        "state": "offline"
      },
      "apply": {
        "model": "controllerplus:block/self_powered_controller"
      }
    },
    {
      "when": {
        "state": "online"
      },
      "apply": {
        "model": "controllerplus:block/self_powered_controller_active"
      }
    },
    {
      "when": {
        "state": "conflicted"
      },
      "apply": {
        "model": "controllerplus:block/self_powered_controller_conflicted"
      }
    }
  ]
}
